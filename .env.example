# Puerto del servidor local
PORT=3000

# Token que TÚ inventas y pones también en el dashboard de Meta al configurar el webhook
VERIFY_TOKEN=elige-un-token-secreto-cualquiera

# Versión de la Graph API
GRAPH_API_VERSION=v21.0

# --- WhatsApp Cloud API ---
# Meta for Developers > tu App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Instagram Messaging API ---
# Requiere una cuenta de Instagram Business/Creator vinculada a una Página de Facebook.
# El token es el Page Access Token de esa página.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
