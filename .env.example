# Sitio de Mercado Libre (MLC = Chile)
ML_SITE=MLC

# Cuántos posts generar al día y filtros de calidad
POSTS_PER_DAY=5
MIN_RATING=4.5
MIN_REVIEWS=10

# App de Mercado Libre (developers.mercadolibre.com/devcenter). Ver SETUP.md,
# sección "API oficial de Mercado Libre (OAuth)". El refresh_token NO va acá,
# queda guardado aparte (fuera del repo) tras correr scripts/ml-oauth-setup.js.
ML_APP_ID=
ML_APP_SECRET=

# Link de afiliado Mercado Libre: saca estos valores desde un link generado
# en tu panel de Afiliados ML. Ver SETUP.md, sección "Afiliados Mercado Libre".
ML_AFFILIATE_MATT_TOOL=
ML_AFFILIATE_MATT_WORD=

# Opcional: si lo defines, los captions se generan con Claude en vez de la plantilla fija.
ANTHROPIC_API_KEY=

# Instagram Graph API. Ver SETUP.md, sección "Cuenta de Instagram Business + Meta Graph API".
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Se completa automáticamente en el workflow de GitHub Actions al desplegar GitHub Pages.
# Solo necesario si corres src/publish.js manualmente.
PAGES_BASE_URL=
